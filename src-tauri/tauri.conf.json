{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blueprint3D",
  "mainBinaryName": "blueprint3d",
  "version": "0.12.0",
  "identifier": "io.github.leoceo99.blueprint3d",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "도면3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Three-view sketch to 3D to fully dimensioned drawings (DXF, DWG)",
    "longDescription": "Mechanical part CAD for laptops and tablets. Draw three views to get a 3D model, or open a STEP file from another CAD to get a fully dimensioned drawing saved as DXF or DWG.",
    "copyright": "leoceo99",
    "fileAssociations": [
      {
        "ext": ["b3d"],
        "name": "Blueprint3D Document",
        "description": "Blueprint3D document",
        "role": "Editor",
        "mimeType": "application/x-blueprint3d"
      }
    ]
  }
}
